	partition 'AUC por bloque' = m
		mode: import
		source =
				let
				    Carpeta = if Text.EndsWith(RutaDatos, "\") then RutaDatos else RutaDatos & "\",
				    Origen = Csv.Document(File.Contents(Carpeta & "fact_auc_bloques.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"bloque", type text}, {"variables", type text}, {"auc", type number}, {"auc_sd", type number}, {"pliegues", Int64.Type}}, "en-US"),
				    ConOrden = Table.AddIndexColumn(Tipos, "orden", 1, 1, Int64.Type)
				in
				    ConOrden

	annotation PBI_ResultType = Table

