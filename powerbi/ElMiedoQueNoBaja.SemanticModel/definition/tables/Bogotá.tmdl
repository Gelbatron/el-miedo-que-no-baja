	partition Bogotá = m
		mode: import
		source =
				let
				    Carpeta = if Text.EndsWith(RutaDatos, "\") then RutaDatos else RutaDatos & "\",
				    Origen = Csv.Document(File.Contents(Carpeta & "dim_bogota.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"indicador", type text}, {"descripcion", type text}, {"valor", type number}, {"unidad", type text}, {"fuente", type text}, {"origen", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

