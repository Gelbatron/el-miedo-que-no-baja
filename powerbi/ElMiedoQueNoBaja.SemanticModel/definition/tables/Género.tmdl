table Género
	lineageTag: 18360803-e14f-5019-a450-a9934ef762c7

	column indicador
		dataType: string
		lineageTag: d6a68447-86c0-5976-a28f-32790dc3deae
		summarizeBy: none
		sourceColumn: indicador

		annotation SummarizationSetBy = Automatic

	column mujeres
		dataType: double
		formatString: 0.0
		lineageTag: 3c166ec1-8c93-513c-adce-f86ad291cc03
		summarizeBy: none
		sourceColumn: mujeres

		annotation SummarizationSetBy = Automatic

	column hombres
		dataType: double
		formatString: 0.0
		lineageTag: 25678a0d-03a2-5b29-8928-a086b992b00b
		summarizeBy: none
		sourceColumn: hombres

		annotation SummarizationSetBy = Automatic

	column etiqueta
		dataType: string
		lineageTag: 5380e7bc-3733-5c28-984c-4833899cd495
		summarizeBy: none
		sourceColumn: etiqueta
		sortByColumn: orden

		annotation SummarizationSetBy = Automatic

	column orden
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fa385e55-bb5e-5858-9a86-73da724ec3ca
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = Automatic

	partition Género = m
		mode: import
		source =
				let
				    Carpeta = if Text.EndsWith(RutaDatos, "\") then RutaDatos else RutaDatos & "\",
				    Origen = Csv.Document(File.Contents(Carpeta & "fact_genero_emv.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"indicador", type text}, {"mujeres", type number}, {"hombres", type number}}, "en-US"),
				    Etiquetas = [teme_acoso_sexual = "Teme el acoso sexual", no_sale_noche = "Evita salir de noche", barrio_inseguro = "Se siente insegura/o en su barrio", victima = "Fue víctima de un delito"],
				    Orden = [teme_acoso_sexual = 1, no_sale_noche = 2, barrio_inseguro = 3, victima = 4],
				    ConEtiqueta = Table.AddColumn(Tipos, "etiqueta", each Record.FieldOrDefault(Etiquetas, [indicador], [indicador]), type text),
				    ConOrden = Table.AddColumn(ConEtiqueta, "orden", each Record.FieldOrDefault(Orden, [indicador], 99), Int64.Type)
				in
				    ConOrden

	annotation PBI_ResultType = Table

